# ============================================================
# STANDARD PACKAGE — CLIENT CONFIGURATION
# Copy this file to .env.local and fill in the values below
# before delivery. Never commit .env.local to the repository.
# ============================================================

# Site identity
NEXT_PUBLIC_SITE_NAME=YourBrand
NEXT_PUBLIC_SITE_URL=https://yourclientdomain.com

# Contact form — choose one service and paste its endpoint/key
# Formspree:  https://formspree.io  (paste your form endpoint URL)
# EmailJS:    https://emailjs.com   (paste your service ID)
# Resend:     https://resend.com    (paste your API key)
NEXT_PUBLIC_FORM_ENDPOINT=
